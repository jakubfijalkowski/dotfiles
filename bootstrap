#!/usr/bin/env zsh
set -e -o pipefail

script_name="$(basename "$0")"
dotfiles_dir="$(cd "$(dirname "$0")"; pwd)"
cd "$dotfiles_dir"

##### Helpers

function section() {
  echo ""
  echo "#############################"
  echo "$1"
  echo "#############################"
}

function link() {
  from="$1"
  to="$2"
  if [[ -z "$to" ]]; then
    to="$HOME/.$1"
  fi

  orig_file="$dotfiles_dir/$from"
  dest_file="$to"

  # Backup if destination exists
  if [[ -e "$dest_file" || -L "$dest_file" ]]; then
    backup_dir="$HOME/.dotfiles.bak"
    backup_path="$backup_dir$dest_file"
    mkdir -p "$(dirname "$backup_path")"
    mv "$dest_file" "$backup_path"
    echo "Backed up $dest_file to $backup_path"
  fi

  # Create symlink
  mkdir -p "$(dirname "$dest_file")"
  ln -s "$orig_file" "$dest_file"
  echo "$dest_file -> $orig_file"
}

function copy() {
  from="$dotfiles_dir/$1"
  to="$2"
  if [[ -z "$to" ]]; then
    to="/$1"
  fi

  # Backup if destination exists
  if [[ -e "$to" || -L "$to" ]]; then
    backup_dir="$HOME/.dotfiles.bak"
    backup_path="$backup_dir$to"
    mkdir -p "$(dirname "$backup_path")"
    mv "$to" "$backup_path"
    echo "Backed up $to to $backup_path"
  fi

  # Copy file
  mkdir -p "$(dirname "$to")"
  cp -R "$from" "$to"
  echo "$to <= $from"
}

function service() {
  target="$1"
  name="$2"
  if [[ "$target" == "user" ]]; then
    echo "Enabling user service $name"
    systemctl --user enable --now $name
  elif [[ "$target" == "system" ]]; then
    echo "Enabling system service $name"
    systemctl --system enable --now $name
  else
    echo "Unknown service target"
    exit 1
  fi
}

##### Actions

function configure_user() {
  section "Configuring user dotfiles"

  # Core dotfiles
  link "fdignore"
  link "gitconfig"
  link "zsh"
  link "zshrc"

  # Browser flags
  link "config/chrome-flags.conf"
  link "config/electron-flags.conf"
  link "config/spotify-flags.conf"

  # GPG configuration
  link "gnupg/gpg-agent.conf"
  link "gnupg/gpg.conf"

  # Application configurations
  link "config/bat/bat.conf"
  link "config/bat/themes/gruvbox.tmTheme"
  link "config/fontconfig/fonts.conf"

  # Neovim
  link "config/nvim/init.lua"
  link "config/nvim/coc-settings.json"
  link "config/nvim/lua"

  # Wayland/Hyprland setup
  link "config/hypr/hyprland.conf"
  link "config/hypr/hyprlock.conf"
  link "config/hypr/hypridle.conf"
  link "config/hypr/xdph.conf"
  link "config/hypr/conf"

  link "config/ghostty/config"

  link "config/waybar/config.jsonc"
  link "config/waybar/style.css"
  link "config/waybar/colors.css"

  link "config/walker/config.toml"
  link "config/walker/themes/custom/style.css"
  link "config/walker/themes/custom/colors.css"

  link "config/satty/config.toml"

  link "config/swaync/config.json"
  link "config/swaync/style.css"

  link "config/wpaperd/config.toml"

  link "config/uwsm/env"

  # Systemd user services
  link "config/systemd/user/ssh-add-keys.service"

  # VS Code configuration
  link "config/Code/User/settings.json"
  link "config/Code/User/locale.json"
  link "config/Code/User/keybindings.json"
  link "config/Code/User/snippets"

  # Scripts - link individually to ~/.local/bin
  link "$dotfiles_dir/scripts/check-updates" "$HOME/.local/bin/check-updates"
  link "$dotfiles_dir/scripts/unblock-docker-bridge" "$HOME/.local/bin/unblock-docker-bridge"
  link "$dotfiles_dir/scripts/yubikey-touch-status" "$HOME/.local/bin/yubikey-touch-status"

  section "Importing GPG key"
  chmod 0700 ~/.gnupg
  curl -s https://keybase.io/jakubfijalkowski/pgp_keys.asc | gpg --import

  section "User services"
  systemctl --user daemon-reload
  service "user" "gnome-keyring-daemon.service"
  service "user" "hypridle.service"
  service "user" "ssh-add-keys.service"
  service "user" "ssh-agent.service"
  service "user" "swaync.service"
  service "user" "waybar.service"
  service "user" "yubikey-touch-detector.service"

  elephant service enable
}

function configure_root() {
  section "Configuring system files"

  # Network configuration
  copy "etc/iwd/main.conf"
  copy "etc/systemd/resolved.conf"
  copy "etc/systemd/network/19-home.network"
  copy "etc/systemd/network/20-wireless.network"
  copy "etc/systemd/network/89-ethernet.network"

  # Package manager
  copy "etc/pacman.conf"
  copy "etc/pacman.d/hooks/98-limine.hook"
  copy "etc/pacman.d/hooks/99-refresh_updates.hook"

  # PAM configuration
  copy "etc/pam.d/sudo"
  copy "etc/pam.d/hyprlock"
  copy "etc/pam.d/sddm"

  # Display manager (SDDM)
  copy "etc/sddm.conf.d/theme.conf"
  copy "etc/sddm.conf.d/wayland.conf"
  copy "etc/sddm.conf.d/hyprland.conf" "/opt/hyprsddm/hyprland.conf"

  section "System services"
  systemctl daemon-reload
  service "system" "iwd.service"
  service "system" "pcscd.service"
  service "system" "ufw.service"

  section "Configuring network"
  ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
  service "system" "systemd-networkd.service"
  service "system" "systemd-resolved.service"

  section "Firewall"
  ufw --force reset >/dev/null
  ufw default allow outgoing
  ufw default deny incoming
  ufw enable
  find /etc/ufw -type f -name '*.rules.*' -delete

  section "udev rules"
  copy "etc/udev/rules.d/20-backlight.rules"
  copy "etc/udev/rules.d/30-security-key.rules"
  udevadm control --reload
  udevadm trigger
}

function enable_sddm() {
  service "system" "sddm.service"
}

function run_root_config() {
  section "Switching to root and running config"
  sudo -s "$dotfiles_dir/$script_name"
}

function prepare_default_dirs() {
  section "Making default directories"
  mkdir -p ~/Work
  mkdir -p ~/Documents/GDrive
}

if [[ "$(whoami)" == "root" ]]; then
  configure_root
  enable_sddm
else
  configure_user
  prepare_default_dirs
  run_root_config
fi

