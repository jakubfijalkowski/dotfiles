{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": ["mpris"],
  "modules-right": [
    "custom/yubikey",
    "custom/updates",
    "systemd-failed-units",
    "bluetooth",
    "wireplumber",
    "clock#date",
    "clock#time",
    "custom/notifications",
    "tray",
    "group/group-power"
  ],

  "hyprland/workspaces": {
    "format": "{icon}: {windows}",
    "persistent-workspaces": {
      "*": 5
    },
    "format-window-separator": " ",
    "window-rewrite-default": "",
    "window-rewrite": {
      "google-chrome": "\uf268",
      "chromium": "\uf268",
      "brave-browser": "\uf268",

      "pavucontrol": "\uf028",
      "blueberry.py": "",

      "ghostty": "\uf120",
      "jetbrains-studio": "\uf121",
      "org.gnome.nautilus": "\uf0c5",
      "slack": "\uf198",
      "spotify": "\uf1bc",
      "code": "\uf121",
      "vscode": "\uf121",
      "1password": "\ueb11"
    }
  },

  "mpris": {
	"format": " {dynamic}",
	"format-paused": "{status_icon} {dynamic}",
	"status-icons": {
      "paused": "⏸"
	},
    "dynamic-order": ["artist", "title"]
  },

  "clock#time": {
    "format": "{:%H:%M}"
  },

  "clock#date": {
    "format": "{:L%d %B %y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "format": {
        "months":     "<b>{}</b>",
        "days":       "<b>{}</b>",
        "weekdays":   "<b>{}</b>",
        "today":      "<b><u>{}</u></b>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
      "on-click-middle": "reset"
    }
  },

  "systemd-failed-units": {
      "hide-on-ok": true,
      "format": "✗ {nr_failed}",
      "system": true,
      "user": true
  },

  "custom/updates": {
    "exec": "~/.local/bin/check-updates",
    "hide-empty-text": true,
    "interval": 3600,
    "return-type": "json",
    "format": "{}",
    "signal": 1,
    "on-click": "xdg-terminal-exec -- yay -Syu --devel"
  },
  "custom/yubikey": {
    "exec": "~/.local/bin/yubikey-touch-status",
    "hide-empty-text": true,
    "restart-interval": 60,
    "return-type": "json",
    "format": "{}",
    "on-click": "xdg-terminal-exec -- yay -Syu --devel"
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "",
    "on-click": "blueberry",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_battery_percentage}%"
  },
  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "uwsm app pavucontrol",
    "scroll-step": 5
  },
  "tray": {
    "icon-size": 16,
    "spacing": 0
  },

  "custom/notifications": {
    "tooltip": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "group/group-power": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "children-class": "not-power",
      "transition-left-to-right": false
    },
    "modules": [
      "custom/power",
      "custom/quit",
      "custom/lock",
      "custom/reboot"
    ]
  },
  "custom/quit": {
    "format": "󰗼",
    "on-click": "hyprctl dispatch exit",
    "tooltip": true,
    "tooltip-format": "Logout"
  },
  "custom/lock": {
    "format": "󰍁",
    "on-click": "hyprlock",
    "tooltip": true,
    "tooltip-format": "Lock"
  },
  "custom/reboot": {
    "format": "󰜉",
    "on-click": "reboot",
    "tooltip": true,
    "tooltip-format": "Reboot"
  },
  "custom/power": {
    "format": "",
    "on-click": "shutdown now",
    "tooltip": true,
    "tooltip-format": "Shutdown"
  },

  /* vim: set ft=jsonc ts=2 sw=2: */
}
